# {{ ansible_managed }} -- daily changed blocks since the last level 0/1
BACKUP INCREMENTAL LEVEL 1 DATABASE TAG 'LEVEL1' PLUS ARCHIVELOG NOT BACKED UP 1 TIMES TAG 'ARCH';
CROSSCHECK BACKUP;
CROSSCHECK ARCHIVELOG ALL;
DELETE NOPROMPT EXPIRED BACKUP;
DELETE NOPROMPT EXPIRED ARCHIVELOG ALL;
DELETE NOPROMPT OBSOLETE;
LIST BACKUP SUMMARY;
